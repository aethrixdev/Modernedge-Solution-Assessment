# Copy to .env and fill in. .env is never committed.

# LLM that reads the call-out messages (Groq for now).
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# LLM_MODE=live|replay|off     # default: live if GROQ_API_KEY is set, else off
# LLM_CACHE_DIR=cache/llm      # saved replies, so re-runs cost nothing

# Folder with the client files. Default ./data
# DATA_DIR=../ModernEdge_AI_Solutions_Engineer_Assessment/data

# true = never write to payroll, only log what would be written.
# Unset on purpose: a local run defaults to true (safe); Docker sets false.
# DRY_RUN=true

# The three client systems. Defaults: http://localhost:8081 / 8082 / 8083
# PAYROLL_URL=
# DISPATCH_URL=
# FINANCE_URL=

# Credentials for those systems (defaults are the ones in each API.md).
# PAYROLL_API_KEY=assess-7f3c9a
# DISPATCH_CLIENT_ID=me-assess
# DISPATCH_CLIENT_SECRET=d1sp4tch-s3cret
# FINANCE_USER=svc_assess
# FINANCE_PASSWORD=Q4-close!
